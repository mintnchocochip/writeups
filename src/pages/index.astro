---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE, url } from '../consts';

const posts = (await getCollection('writeups')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			main {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 3em 1em;
			}
			ul {
				list-style: none;
				margin: 0;
				padding: 0;
			}
			li {
				padding: 1em 0;
				border-bottom: 1px solid rgb(var(--gray-light));
			}
			li a {
				text-decoration: none;
			}
			.title {
				margin: 0 0 0.2em 0;
				font-size: 1.25em;
				color: rgb(var(--black));
				line-height: 1.3;
			}
			li a:hover .title {
				color: rgb(var(--accent));
			}
			.meta {
				display: flex;
				flex-wrap: wrap;
				align-items: baseline;
				gap: 0.5em;
				color: rgb(var(--gray));
				font-size: 0.9em;
			}
			.tag {
				padding: 0.1em 0.5em;
				border-radius: 4px;
				background: rgb(var(--gray-light));
				font-size: 0.85em;
			}
			.empty {
				color: rgb(var(--gray));
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>Writeups</h1>
			{
				posts.length === 0 ? (
					<p class="empty">
						Nothing published yet. Import a Notion export with
						<code>node scripts/import-notion.mjs &lt;export-dir&gt;</code>.
					</p>
				) : (
					<ul>
						{posts.map((post) => (
							<li>
								<a href={url(`/${post.id}/`)}>
									<h2 class="title">{post.data.title}</h2>
								</a>
								<div class="meta">
									<FormattedDate date={post.data.pubDate} />
									{post.data.tags.map((tag) => (
										<span class="tag">{tag}</span>
									))}
								</div>
							</li>
						))}
					</ul>
				)
			}
		</main>
		<Footer />
	</body>
</html>
